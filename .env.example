# ===== DeepSeek 模型（OpenAI 兼容）=====
LLM_API_KEY=sk-你的DeepSeekKey
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=600

# ===== Tavily 联网搜索 =====
TAVILY_API_KEY=tvly-你的TavilyKey

# ===== 服务配置 =====
PORT=5000
# 可选：设置后所有 API 需携带 Authorization: Bearer <key>
AUTH_API_KEY=
# 可选：单次执行超时（秒），默认 900
AGENT_TIMEOUT_SECONDS=900

# ===== 本地会话记忆 =====
# SQLite 文件路径，默认 data/memory.db（重启不丢）
MEMORY_DB_PATH=data/memory.db
